<Window x:Class="CarsharingApp.AddCarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarsharingApp"
        mc:Ignorable="d"
        Title="Окно добавления машин" Height="330" Width="350">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4682B4" Offset="0.0"/>
            <GradientStop Color="#00CED1" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Добавить машину"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10" FontFamily="Bahnschrift"/>


        <Label Content="Модель:" Grid.Row="1"/>
        
        <TextBox  x:Name="Model" 
                  Grid.Row="1"
                  Margin="116,0,0,05"/>

        <Label Content="Цена за час:" Grid.Row="2"/>
        
        <TextBox  x:Name="PricePerHour" 
                  Grid.Row="2" 
                  Margin="116,0,0,05"/>

        <Label Content="Номер:" Grid.Row="3"/>
        
        <TextBox  x:Name="Number" 
                  Grid.Row="3" 
                  Margin="116,0,0,05"/>

        <Label Content="Цвет:" Grid.Row="4"/>
        
        <TextBox  x:Name="Color" 
                  Grid.Row="4" 
                  Margin="116,0,0,05"/>

        <Label Content="Расход топлива:" Grid.Row="5"/>
        
        <TextBox  x:Name="FuelConsumption"
                  Grid.Row="5" 
                  Margin="116,0,0,05"/>

        <Label Content="Число мест:" Grid.Row="6"/>
        
        <TextBox  x:Name="NumberOfSeats" 
                  Grid.Row="6" 
                  Margin="116,0,0,05"/>

        <Label Content="Класс автомобиля:" Grid.Row="7"/>
        
        <TextBox  x:Name="CarClass" 
                  Grid.Row="7" 
                  Margin="116,0,0,05"/>

        <Button Content="Добавить"
            Width="120" 
            Height="30"     
            Background="#B0E0E6"    
            FontWeight="Bold"
            HorizontalAlignment="Center"
            Cursor="Hand"   
            Grid.Row="8" 
            Margin="0,10,0,0" 
            BorderThickness="0"/>

    </Grid>
</Window>
