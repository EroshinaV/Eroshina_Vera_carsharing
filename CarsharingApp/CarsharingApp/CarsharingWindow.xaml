<Window x:Class="CarsharingApp.CarsharingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarsharingApp"
        mc:Ignorable="d"
        Title="Carsharing" Height="450" Width="800">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4682B4" Offset="0.0"/>
            <GradientStop Color="#00CED1" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Каршеринг"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10" FontFamily="Bahnschrift"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Top" Width="600">

            <Label Content="Ваше имя:"/>
            
            <TextBox 
              x:Name="txtUsername"
              HorizontalAlignment="Left"
              Margin="0,5,0,10"  
              Height="20"
              Width="200"
              BorderThickness="1"/>
            
            <DataGrid Name="GuestsDataGrid" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>


    </Grid>
</Window>
