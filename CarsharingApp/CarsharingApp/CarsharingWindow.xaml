<Window x:Class="CarsharingApp.CarsharingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarsharingApp"
        mc:Ignorable="d"
        Title="Carsharing window" Height="450" Width="800">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4682B4" Offset="0.0"/>
            <GradientStop Color="#00CED1" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Каршеринг"
               FontSize="24"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,10" FontFamily="Bahnschrift"/>

        <Grid Grid.Row="1" VerticalAlignment="Top" Width="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Ваше имя:"/>

            <TextBox x:Name="Username"
                 Grid.Row="1"
                 HorizontalAlignment="Left"
                 Margin="0,5,0,10"  
                 Height="20"
                 Width="200"
                 BorderThickness="1"/>

            <DataGrid Name="GuestsDataGrid" 
                  Grid.Row="2" 
                  AutoGenerateColumns="False" 
                  Height="200">
                <DataGrid.Columns>
                   
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left">

                <Button Content="Забронировать"
                    Width="120" 
                    Height="30"     
                    Background="#B0E0E6"    
                    FontWeight="Bold"
                    Cursor="Hand"   
                    BorderThickness="0" 
                    Click="BookButton_Click"
                    Margin="0,0,10,0"/>

                <Button Content="Удалить бронирование"
                    Width="150" 
                    Height="30"   
                    Background="#B0E0E6"    
                    FontWeight="Bold"
                    Cursor="Hand"   
                    BorderThickness="0" 
                    Click="DeleteButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
