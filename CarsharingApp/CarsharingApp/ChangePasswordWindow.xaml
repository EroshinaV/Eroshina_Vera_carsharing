<Window x:Class="CarsharingApp.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarsharingApp"
        mc:Ignorable="d"
        Title="Окно смены пароля"  Height="370" Width="400">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4682B4" Offset="0.0"/>
            <GradientStop Color="#00CED1" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>


     <Grid Margin="20">
         <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
         </Grid.RowDefinitions>

         <TextBlock Text="Смена пароля"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10" FontFamily="Bahnschrift"/>

         <StackPanel Grid.Row="1" VerticalAlignment="Center" Width="250">

            <TextBlock Text="Текущий пароль" FontWeight="Bold" FontSize="14"  />

            <TextBox 
                   x:Name="Username" 
                   Margin="0,5,0,10"  
                   Height="35"  
                   BorderThickness="1"/>

            <TextBlock Text="Новый пароль" FontWeight="Bold" FontSize="14"/>

            <PasswordBox x:Name="Password" 
                   Margin="0,5,0,10"  
                   Height="35"  
                   BorderThickness="1"/>

            <TextBlock Text="Потверждение нового пароля" FontWeight="Bold" FontSize="14"/>

            <PasswordBox x:Name="Password2" 
                   Margin="0,5,0,10"  
                   Height="35"  
                   BorderThickness="1"/>


            <Button Content="Изменить пароль"
                   Width="120" 
                   Height="30"  
                   Background="#B0E0E6"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Cursor="Hand"   
                   Margin="0,10,0,0" 
                   BorderThickness="0" Click="Button_Click"/>

          </StackPanel>
     </Grid>
</Window>
