<Page x:Class="CarsharingApp.ApiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarsharingApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ApiPage">
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4682B4" Offset="0.0"/>
            <GradientStop Color="#00CED1" Offset="1.0"/>
        </LinearGradientBrush>
    </Page.Background>

    <Grid>
    
        <StackPanel Margin="30" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top">

            <Button Content="Получить данные"
                    Width="200" 
                    Height="30"  
                    Background="#B0E0E6"
                    FontWeight="Bold"
                    Cursor="Hand"   
                    Margin="0,0,0,10" 
                    BorderThickness="0"/>

            <Button Content="Отправить данные для теста"
                    Width="200" 
                    Height="30"  
                    Background="#B0E0E6"
                    FontWeight="Bold"
                    Cursor="Hand" 
                    BorderThickness="0"/>

        </StackPanel>
    </Grid>
</Page>

