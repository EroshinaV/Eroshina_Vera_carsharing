<Window x:Class="CarsharingApp.Cars"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarsharingApp"
        mc:Ignorable="d"
        Title="Список машин" Height="450" Width="800">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4682B4" Offset="0.0"/>
            <GradientStop Color="#00CED1" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Список машин"
           FontSize="24"
           FontWeight="Bold"
           HorizontalAlignment="Center"
           Margin="0,10" FontFamily="Bahnschrift"/>

        <Grid Grid.Row="1" VerticalAlignment="Top" Width="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid Name="GuestsDataGrid" 
              Grid.Row="2" 
              AutoGenerateColumns="False" 
              Height="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Модель" Binding="{Binding model}" Width="Auto"/>
                    <DataGridTextColumn Header="Цена за час" Binding="{Binding PricePerHour}" Width="Auto"/>
                    <DataGridTextColumn Header="Номер" Binding="{Binding number}" Width="Auto"/>
                    <DataGridTextColumn Header="Цвет" Binding="{Binding color}" Width="Auto"/>
                    <DataGridTextColumn Header="Расход топлива" Binding="{Binding FuelConsumption}" Width="Auto"/>
                    <DataGridTextColumn Header="Число мест" Binding="{Binding NumberOfSeats}" Width="Auto"/>
                    <DataGridTextColumn Header="Класс автомобиля" Binding="{Binding CarClass}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3" 
                Orientation="Horizontal" 
                Margin="0,10,0,0"
                HorizontalAlignment="Center">

                <Button Content="Добавить машину"
                Width="130" 
                Height="30"     
                Background="#B0E0E6"    
                FontWeight="Bold"
                Cursor="Hand"   
                BorderThickness="0" 
                Click="AddCarButton_Click"
                Margin="0,0,10,0"/>

                <Button Content="Удалить машину"
                Width="130" 
                Height="30"   
                Background="#B0E0E6"    
                FontWeight="Bold"
                Cursor="Hand"   
                BorderThickness="0" 
                Click="DeleteButton_Click"
                Margin="0,0,10,0"/>

                <Button Content="Экран бронирования"
                Width="150" 
                Height="30"   
                Background="#B0E0E6"    
                FontWeight="Bold"
                Cursor="Hand"   
                BorderThickness="0" 
                Click="NavigateToBooking_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
