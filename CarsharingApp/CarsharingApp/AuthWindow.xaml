<Window x:Class="CarsharingApp.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarsharingApp"
        mc:Ignorable="d"
        Title="Авторизация" Height="450" Width="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Авторизация"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10" FontFamily="Bahnschrift"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Width="400">
            
            <TextBlock Text="Логин" FontWeight="Bold" FontSize="14"  />

            <TextBox 
              x:Name="txtUsername" 
              Margin="0,5,0,10"  
              Height="35"  
              BorderThickness="1"/>

            <TextBlock Text="Пароль" FontWeight="Bold" FontSize="14"/>

            <PasswordBox x:Name="txtPassword" 
                 Margin="0,5,0,10"  
                 Height="35"  
              
                 BorderThickness="1"/>

            <Button Content="Войти"
               Width="120" 
               Height="30"     
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Cursor="Hand"   
               Margin="0,10,0,0" 
               BorderThickness="0" Click="Button_Click"/>
            
        </StackPanel>
    </Grid>
</Window>
